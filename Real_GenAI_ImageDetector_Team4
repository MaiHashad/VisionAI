ory\n","def sample_images_from_directory(directory, sample_fraction=.1, seed = 42):\n","    all_images = []\n","    for root, _, files in os.walk(directory):\n","        images = [os.path.join(root, f) for f in files if f.lower().endswith(('.png', '.jpg', '.jpeg'))]\n","        all_images.extend(images)\n","\n","    # Sample 10% of the images\n","    sample_size = int(sample_fraction * len(all_images))\n","    random.seed(seed)\n","    sampled_images = random.sample(all_images, sample_size) if sample_size > 0 else []\n","\n","    return sampled_images\n","\n","# Sample images from the train and test directories\n","sampled_train_images = sample_images_from_directory(train_dir)\n","sampled_test_images = sample_images_from_directory(test_dir)\n","\n","print(f\"Sampled {len(sampled_train_images)} images from train directory.\")\n","print(f\"Sampled {len(sampled_test_images)} images from test directory.\")"]},{"cell_type":"markdown","metadata":{"id":"W2rnJYyXtOKa"},"source":["## Image Preprocessing\n","\n","**ONE TIME EXECUTION**"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"FRxm4sb154qC"},"outputs":[],"source":["def remove_empty_files(image_list):\n","    return [img for img in image_list if os.path.getsize(img) > 0]\n","\n","sampled_train_images = remove_empty_files(sampled_train_images)\n","sampled_test_images = remove_empty_files(sampled_test_images)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"3XLfRkTF_4H0"},"outputs":[],"source":["# Resize function - Resize all images to a manageable resolution\n","def resize_image(image_path, size=(224, 224)):\n","    try:\n","        directory = os.path.dirname(image_path)\n","        if not os.path.exists(directory):\n","            print(f\"Directory does not exist: {directory}\")\n","            return False\n","\n","        with Image.open(image_path) as img:\n","            # If the image has transparency, convert it to 'RGBA'\n","            if img.mode == 'P' or img.mode == 'RGBA':\n","                img = img.convert('RGBA')\n","                # Replace transparency with a solid background (e.g., white)\n","                img = img.convert(\"RGB\", palette=Image.ADAPTIVE)\n","\n","            # Convert to RGB if necessary (ensures compatibility with JPEG)\n","            elif img.mode != 'RGB':\n","                img = img.convert('RGB')\n","\n","            # Check if the image size is already (224, 224)\n","            if img.size == size:\n","                return True\n","\n","            print(f\"Original size: {img.size}\")\n","            img = img.resize(size)\n","            print(f\"Resized size: {img.size}\")\n","\n","            img.save(image_path, format='JPEG')\n","            print(f\"Image saved successfully at {image_path}\")\n","        return True\n","\n","    except Exception as e:\n","        print(f\"Error resizing image {image_path}: {e}\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"GfzhfhLaNE9W"},"outputs":[],"source":["def resize_images_inplace(image_list, size=(224, 224)):\n","    \"\"\"\n","    Resize all images in-place. Remove any problematic images from the list.\n","    \"\"\"\n","    problematic_images = []  # To track images that fail during resizing\n","\n","    for image_path in image_list:\n","        try:\n","            # Call the resize function\n","            success = resize_image(image_path, size)\n","            if not success:\n","                raise Exception(f\"Failed to resize {image_path}\")\n","        except Exception as e:\n","            print(f\"Removing problematic image: {image_path} due to error: {e}\")\n","            problematic_images.append(image_path)\n","            # Delete the file from the drive\n","            try:\n","                os.remove(image_path)\n","                print(f\"Deleted {image_path}\")\n","            except Exception as delete_error:\n","                print(f\"Could not delete {image_path}: {delete_error}\")\n","\n","    # Remove problematic images from the original list\n","    for problematic_image in problematic_images:\n","        image_list.remove(problematic_image)\n","\n","    print(f\"Completed resizing. Removed {len(problematic_images)} problematic images.\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"eKabdz3jNHE_","outputId":"107b7962-f37d-4a99-e4fa-914a9a66f963","executionInfo":{"status":"ok","timestamp":1734033656318,"user_tz":360,"elapsed":9340181,"user":{"displayName":"Mai Hashad","userId":"00700598238583164571"}}},"outputs":[{"output_type":"stream","name":"stdout","text":["Completed resizing. Removed 0 problematic images.\n","Completed resizing. Removed 0 problematic images.\n","Resizing complete for all sampled images.\n"]}],"source":["# Resize sampled images in-place\n","resize_images_inplace(sampled_train_images, size=(224, 224))\n","resize_images_inplace(sampled_test_images, size=(224, 224))\n","\n","print(\"Resizing complete for all sampled images.\")"]},{"cell_type":"markdown","metadata":{"id":"UH3rBlT0fpBe"},"source":["## Global Variables Configuration"]},{"cell_type":"code","execution_count":5,"metadata":{"id":"LThYmkMCfgmI","executionInfo":{"status":"ok","timestamp":1734453614628,"user_tz":360,"elapsed":4,"user":{"displayName":"Jon Van Hofwegen","userId":"04850966980315708625"}}},"outputs":[],"source":["img_height, img_width = 224, 224\n","batch_size = 32\n","num_classes = 2"]},{"cell_type":"code","execution_count":6,"metadata":{"id":"isO6kwpHbgvI","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1734453616966,"user_tz":360,"elapsed":2341,"user":{"displayName":"Jon Van Hofwegen","userId":"04850966980315708625"}},"outputId":"ae886e30-6c27-4510-fb0d-34073da7e876"},"outputs":[{"output_type":"stream","name":"stdout","text":["Train labels distribution:\n","label\n","fake    2440\n","real    2402\n","Name: count, dtype: int64\n","Test labels distribution:\n","la