e":"markdown","metadata":{"id":"omsPuoOAMXFV"},"source":["## Sample, Resize, And Display"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"2d6-D8WMp9rC"},"outputs":[],"source":["# Define a transform to resize the images to 256x256, normalize, and augment\n","transform = transforms.Compose([\n","    transforms.Resize((256, 256)),\n","    transforms.RandomHorizontalFlip(),\n","    transforms.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.2, hue=0.2),\n","    transforms.ToTensor(),\n","    transforms.Normalize(mean=[0.5, 0.5, 0.5], std=[0.5, 0.5, 0.5])\n","])\n","\n","# Function to sample of images from a directory\n","def sample_images_from_directory(directory, sample_fraction, seed=42):\n","    all_images = [os.path.join(directory, f) for f in os.listdir(directory) if f.endswith(('jpg', 'jpeg', 'png'))]\n","    sample_size = int(sample_fraction * len(all_images))\n","    sampled_images = random.sample(all_images, sample_size)\n","    return sampled_images\n","\n","# Custom Dataset Class for loading images from directories\n","class RealFakeDataset(Dataset):\n","    def __init__(self, real_dir, fake_dir, transform=None, sample_fraction=1, seed=42):\n","        self.real_images = sample_images_from_directory(real_dir, sample_fraction)\n","        self.fake_images = sample_images_from_directory(fake_dir, sample_fraction)\n","        self.transform = transform\n","        self.images = self.real_images + self.fake_images\n","        self.labels = [1] * len(self.real_images) + [0] * len(self.fake_images)\n","\n","    def __len__(self):\n","        return len(self.images)\n","\n","    def __getitem__(self, idx):\n","        img_path = self.images[idx]\n","        label = self.labels[idx]\n","        try:\n","            if not os.path.exists(img_path):\n","                print(f\"File not found: {img_path}\")\n","                return torch.zeros(3, 256, 256), -1\n","            image = Image.open(img_path).convert('RGB')\n","            if self.transform:\n","                image = self.transform(image)\n","            return image, label\n","        except (UnidentifiedImageError, OSError) as e:\n","            print(f\"Error loading image {img_path}: {e}\")\n","            return torch.zeros(3, 256, 256), -1\n","\n","# Create the dataset with sampled images\n","dataset = RealFakeDataset(real_images_path, fake_images_path, transform, sample_fraction=sample_fraction, seed = seed)\n","\n","# Split the dataset into train and test sets\n","train_size = int(0.8 * len(dataset))\n","test_size = len(dataset) - train_size\n","train_dataset, test_dataset = torch.utils.data.random_split(dataset, [train_size, test_size])\n","\n","# Create DataLoader for batching and shuffling\n","train_loader = DataLoader(train_dataset, batch_size=32, shuffle=True,num_workers=4)\n","test_loader = DataLoader(test_dataset, batch_size=32, shuffle=False,num_workers=4)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":113,"status":"ok","timestamp":1733549502104,"user":{"displayName":"Seth Dasuki","userId":"04105956317894981487"},"user_tz":360},"id":"ojlQWB7tuvO3","outputId":"91c24567-60ec-430b-dff0-2971cebb2c6c"},"outputs":[{"name":"stdout","output_type":"stream","text":["Total number of samples in the dataset: 48427\n"]}],"source":["total_samples = len(dataset)\n","print(f\"Total number of samples in the dataset: {total_samples}\")"]},{"cell_type":"markdown","metadata":{"id":"EGa-NF3XwHuH"},"source":["## Display Sample"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":259},"executionInfo":{"elapsed":1611,"status":"ok","timestamp":1733549508937,"user":{"displayName":"Seth Dasuki","userId":"04105956317894981487"},"user_tz":360},"id":"wqC1w3QYwFn3","outputId":"66953a11-154d-4921-9588-8699a8cf0879"},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1500x500 with 5 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# Function to sample 5 images (3 real and 2 fake)\n","def sample_images(real_dir, fake_dir, num_real=3, num_fake=2):\n","    real_images = [os.path.join(real_dir, f) for f in os.listdir(real_dir) if f.endswith(('jpg', 'jpeg', 'png'))]\n","    fake_images = [os.path.join(fake_dir, f) for f in os.listdir(fake_dir) if f.endswith(('jpg', 'jpeg', 'png'))]\n","    real_sampled = random.sample(real_images, num_real)\n","    fake_sampled = random.sample(fake_images, num_fake)\n","    return real_sampled + fake_sampled\n","\n","sample_image_paths = sample_images(real_images_path, fake_images_path, num_real=3, num_fake=2)\n","\n","# Load the images and apply transformations\n","sample_images = []\n","sample_labels = []\n","\n","for path in sample_image_paths:\n","    image = Image.open(path).convert('RGB')\n","    image = transform(image)\n","    image = (image + 1) / 2\n","    sample_images.append(image)\n","\n","    if 'real' in path:\n","        sample_labels.append(1)\n","    else:\n","        sample_labels.append(0)\n","\n","# Plot the sample images\n","fig, axes = plt.subplots(1, 5, figsize=(15, 5))\n","\n","for ax, img, label in zip(axes, sample_images, sample_labels):\n","    ax.imshow(img.permute(1, 2, 0).cpu())\n","    ax.axis('off')\n","    ax.set_title('Real' if label == 1 else 'Fake')\n","\n","plt.show()\n"]},{"cell_type":"markdown","metadata":{"id":"5RGkJ5ObLbbH"},"source":["## Develop Classifier"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"P44xzwz6Yb1S"},"outputs":[],"source":["\n","class CNNClassifier(nn.Module):\n","    def __init__(self, num_classes=1):\n","        super(CNNClassifier, self).__init__()\n","        self.conv1 = nn.Conv2d(3, 64, kernel_size=3, stride=1, padding=1)\n","        self.conv2 = nn.Conv2d(64, 128, kernel_size=3, stride=1, padding=1)\n","        self.conv3 = nn.Conv2d(128, 256, kernel_size=3, stride=1, padding=1)\n","        self.conv4 = nn.Conv2d(256, 512, kernel_size=3, stride=1, padding=1)\n","        self.conv5 = nn.Conv2d(512, 1024, kernel_size=3, stride=1, padding=1)\n","        self.pool = nn.MaxPool2d(kernel_size=2, stride=2, padding=0)\n","        self.bn1 = nn.BatchNorm2d(64)\n","        self.bn2 = nn.BatchNorm2d(128)\n","        self.bn3 = nn.BatchNorm2d(256)\n","        self.bn4 = nn.BatchNorm2d(512)\n","        self.fc1 = nn.Linear(512 * 16 * 16, 2048)\n","        self.fc2 = nn.Linear(2048, num_classes)\n","        self.dropout = nn.Dropout(0.7)\n","\n","    def forward(self, x):\n","        x = self.pool(F.relu(self.bn1(self.conv1(x))))\n","        x = self.pool(F.relu(self.bn2(self.conv2(x))))\n","        x = self.pool(F.relu(self.bn3(self.conv3(x))))\n","        x = self.pool(F.relu(self.bn4(self.conv4(x))))\n","        x = x.view(-1, 512 * 16 * 16)\n","        x = self.dropout(F.relu(self.fc1(x)))\n","        x = self.fc2(x)\n","        return x\n"]},{"cell_type":"markdown","metadata":{"id":"8OfnZ8f8LskS"},"source":["##  BIG GAN - 100% Sample"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":2655,"status":"ok","timestamp":1733549524580,"user":{"displayName":"Seth Dasuki","userId":"04105956317894981487"},"user_tz":360},"id":"Wn2TYiUwCqOy","outputId":"e15d9701-744c-4853-8305-7755f2a11ade"},"outputs":[{"name":"stdout","output_type":"stream","text":["----------------------------------------------------------------\n","        Layer (type)               Output Shape         Param #\n","================================================================\n","            Conv2d-1         [-1, 64, 256, 256]           1,792\n","       BatchNorm2d-2         [-1, 64, 256, 256]             128\n","         MaxPool2d-3         [-1, 64, 128, 128]               0\n","            Conv2d-4        [-1, 128, 128, 128]          73,856\n","       BatchNorm2d-5        [-1, 128, 128, 128]             256\n","         MaxPool2d-6          [-1, 128, 64, 64]         